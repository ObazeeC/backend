<title><%= title %> </title>
<h1> <%= title %> </h1>


<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<%- messages() %>

  <!-- ACCOUNT UPDATE FORM -->
   <section class="update-section">
   <h2> Account Update </h2>
   <form action="/account/update" method="post" class="update-form" id="update-account">
    <label for="account_firstname">First Name</label>
    <input type="text" id="account_firstname" name="account_firstname" value="<%= accountData.account_firstname %>" required>

    <label for="account_lastname">Last Name</label>
    <input type="text" id="account_lastname" name="account_lastname" value="<%= accountData.account_lastname%>" required>

     <label for="account_email">Email</label>
     <input type="email" id="account_email" name="account_email" value="<%= accountData.account_email %>" required>

       <!-- Hidden ID -->
      <input type="hidden" name="account_id" value="<%= accountData.account_id %>">

      <button type="submit"> Update Account </button>
   </form>
   </section>

      <!-- PASSWORD UPDATE FORM -->
       <section>
        <h2>Change Password</h2>
        <form action="/account/update-password" method="post" class="update-form" id="update-password">
         <label for="account_password">New Password</label>
         <input type="password" id="account_password" name="account_password" required title="Password must be at least 12 character and include 1 uppercase letter, 1 number, and 1 special character">
        

         <input type="hidden" name="account_id" value="<%= accountData.account_id %>">
         <span><p> Current password will changed </p> </span>
         <button type="submit">Change Password</button>
        </form>
       </section>