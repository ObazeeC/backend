<title><%= title %> </title>
<h1> <%= title %> </h1>

<%- messages() %>
  <div class="class-form"> 
  <form action="/account/register" method="post" id="register_form">
    <label for="account_firstname">First name: </label>
    <input type="text" id="account_firstname" name="account_firstname" required>

    <label for="account_lastname">Last name: </label>
    <input type="text" id="account_lastname" name="account_lastname" required>

     <label for="account_email">Email: </label>
    <input type="email" id="account_email" name="account_email" required>

    <label for="account_password">Password: </label>
    <input 
        type="password"
        id="account_password"
        name="account_password"
        required
        minlength="12"
         pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*]).{12,}$"
         
       title="Password must be at least 12 character and include 1 uppercase letter, 1 number, and 1 special character">


    <span class="password-rule"><p> password must be at least 12 character long and include
             1 uppercase letter 
             1 number
             1 special character
    </p></span>
      
    <button type="submit">Register</button>
  </form>
  
  </div>
