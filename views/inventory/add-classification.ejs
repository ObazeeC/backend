
<title><%= title %> </title>
<h1> Add New Classification </h1>


<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<%- messages() %>

<div class="addClassification">
   <span class="clasiRequired"> <p> Classification name cannot contain space or special character</p></span> 
    <form action="/inv/add-classification" method="post" id="classification-form">
     <label for="classification_name">Enter Classification Name: </label>
     <input type="text"
      id="classification_view" 
      name="classification_name"
      title="Classification name cannot contain space or special character" 
      pattern="^[A-Za-z]+$"
      required value="<%= locals.classification_name %>">
     <button type="submit">Add Classification </button>
    </form>
</div>